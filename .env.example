# Supabase (Project Settings -> API / Database)
# Server-only. NEVER expose the service role key to the client.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only by the Supabase CLI for migrations
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Telegram bot (BotFather)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_BOT_USERNAME=

# Secret Telegram attaches to every webhook POST as
# X-Telegram-Bot-Api-Secret-Token (see api/telegram/webhook/route.ts and
# core.telegram.org/bots/api#setwebhook) -- generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then register it by calling setWebhook once, e.g.:
# curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#   -d "url=$NEXT_PUBLIC_APP_URL/api/telegram/webhook" \
#   -d "secret_token=$TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram user ids allowed to see the in-app ⚙️ admin panel
NEXT_PUBLIC_ADMIN_TELEGRAM_IDS=

# Session signing secret for our own JWT (generate with: openssl rand -base64 32)
SESSION_SECRET=

# Optional: shared secret to protect the Vercel Cron endpoint
CRON_SECRET=

# --- TON shop (real on-chain payments, separate from the simulated GRAM wallet above) ---

# Absolute base URL of the deployed Mini App (no trailing slash). Used to build
# an absolute tonconnect-manifest.json (wallets fetch it — relative URLs won't work)
# and its icon URL.
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# TON wallet address (friendly base64, EQ.../UQ...) that receives shop payments.
# Public on purpose — it's the address users send TON to.
NEXT_PUBLIC_GAME_TREASURY_WALLET=

# "mainnet" or "testnet" — must match the wallet address above and the network
# the user's connected wallet is on.
NEXT_PUBLIC_TON_NETWORK=mainnet

# Optional TonAPI (tonapi.io) bearer key — raises the anonymous rate limit.
# Get one free at https://tonconsole.com. Server-only.
TONAPI_KEY=

# --- Automatic withdrawal payout ---
# The treasury's 24-word seed phrase, space-separated. The server signs and
# sends TON with this on every admin-approved withdrawal — whoever can read
# this env var can drain the wallet it belongs to. Server-only, never log it.
# Keep only what the withdrawal queue needs in this wallet, not the whole
# treasury. Generate a dedicated wallet for this (e.g. a fresh one in
# Tonkeeper) rather than reusing a personal one.
TREASURY_WALLET_MNEMONIC=

# Must match the contract type of the wallet TREASURY_WALLET_MNEMONIC
# belongs to, or the derived address won't match NEXT_PUBLIC_GAME_TREASURY_WALLET
# and payouts will fail loudly at send time. "v4" (most common) or "v3r2".
TREASURY_WALLET_VERSION=v4

# Optional Toncenter API key (separate service from TonAPI above) — used
# only for the outgoing payout client (lib/ton-wallet-sender.ts). Get one
# free via the @tonapibot on Telegram. Server-only.
TONCENTER_API_KEY=
