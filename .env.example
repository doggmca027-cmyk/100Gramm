# Supabase (Project Settings -> API / Database)
# Server-only. NEVER expose the service role key to the client.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only by the Supabase CLI for migrations
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Telegram bot (BotFather)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_BOT_USERNAME=

# Session signing secret for our own JWT (generate with: openssl rand -base64 32)
SESSION_SECRET=

# Optional: shared secret to protect the Vercel Cron endpoint
CRON_SECRET=
